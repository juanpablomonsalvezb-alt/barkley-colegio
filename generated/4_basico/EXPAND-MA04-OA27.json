      {"question_type":"opcion_multiple","question_text":"100 personas encuestadas: 60 verde, 25 azul, 15 rojo. Si saco 20 personas más y 12 dicen verde, ¿qué % nuevo de verde?","options":[{"id":"a","text":"60% (72 de 120)"},{"id":"b","text":"50%"},{"id":"c","text":"70%"},{"id":"d","text":"80%"}],"correct_answer":"a","feedback_correct":"¡Bien! Verde total=72. 72/120=60%.","feedback_incorrect":"60+12=72 verde. Total=120. 72/120=60%.","difficulty_level":3,"points":1},

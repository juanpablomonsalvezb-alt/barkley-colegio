      {"question_type":"opcion_multiple","question_text":"Si una barra mide 12 y otra 4, ¿cuántas veces más es la primera?","options":[{"id":"a","text":"3 veces"},{"id":"b","text":"8 veces"},{"id":"c","text":"4 veces"},{"id":"d","text":"12 veces"}],"correct_answer":"a","feedback_correct":"¡Bien! 12÷4=3.","feedback_incorrect":"12÷4=3.","difficulty_level":2,"points":1},

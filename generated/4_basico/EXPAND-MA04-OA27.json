      {"question_type":"opcion_multiple","question_text":"Si lunes=5 y viernes=15, la diferencia es:","options":[{"id":"a","text":"10"},{"id":"b","text":"20"},{"id":"c","text":"5"},{"id":"d","text":"15"}],"correct_answer":"a","feedback_correct":"¡Bien!","feedback_incorrect":"15-5=10.","difficulty_level":1,"points":1},
      {"question_type":"opcion_multiple","question_text":"El eje horizontal de gráfico muestra:","options":[{"id":"a","text":"Categorías"},{"id":"b","text":"Cantidad"},{"id":"c","text":"Total"},{"id":"d","text":"Promedio"}],"correct_answer":"a","feedback_correct":"¡Bien!","feedback_incorrect":"X=categorías.","difficulty_level":1,"points":1}
    ]},

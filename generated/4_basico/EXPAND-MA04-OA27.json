      {"question_type":"completar","question_text":"Tabla A=24, B=18, C=12. Categoría A es ___% del total (sin %)","options":[{"id":"blank","text":"___"}],"correct_answer":"44","feedback_correct":"¡Bien! 24/54≈44%.","feedback_incorrect":"24/54=44,4% ≈ 44.","difficulty_level":3,"points":1},

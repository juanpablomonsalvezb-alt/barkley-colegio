        {"question_type":"opcion_multiple","question_text":"Una comuna tiene 8 600 habitantes. Descomponiendo, ¿cuál es correcto?","options":[{"id":"a","text":"8 000 + 600"},{"id":"b","text":"800 + 60"},{"id":"c","text":"8 + 6"},{"id":"d","text":"80 + 600"}],"correct_answer":"a","feedback_correct":"¡Bien!","feedback_incorrect":"8 = miles, 6 = centenas → 8 000 + 600.","difficulty_level":2,"points":1},
